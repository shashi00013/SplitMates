generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(uuid())
  name                  String
  email                 String                   @unique
  password              String
  avatar                String?
  color                 String                   @default("#CCFF00")
  passwordResetToken   String?                  @map("password_reset_token")
  passwordResetExpires DateTime?                @map("password_reset_expires")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  createdGroups         Group[]                  @relation("GroupCreator")
  memberships           GroupMember[]
  paidExpenses          Expense[]                @relation("ExpensePayer")
  expenseShares         ExpenseShare[]
  settlementCompleter   Settlement[]             @relation("SettlementCompleter")
  settlementConfirmations SettlementConfirmation[]
  notifications         Notification[]

  @@map("users")
}

model Group {
  id          String         @id @default(uuid())
  name        String
  icon        String         @default("🏠")
  description String?
  inviteCode  String         @unique @default(uuid()) @map("invite_code")
  createdBy   String         @map("created_by")
  creator     User           @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  members     GroupMember[]
  expenses    Expense[]
  cycles      ExpenseCycle[]
  settlements Settlement[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@map("group_members")
}

model ExpenseCycle {
  id           String    @id @default(uuid())
  groupId      String    @map("group_id")
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startDate    DateTime  @default(now()) @map("start_date")
  endDate      DateTime? @map("end_date")
  status       String    @default("active") // "active", "closed"
  settlementId String?   @unique @map("settlement_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  expenses     Expense[]

  @@index([groupId, status])
  @@map("expense_cycles")
}

model Expense {
  id           String        @id @default(uuid())
  groupId      String        @map("group_id")
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cycleId      String?       @map("cycle_id")
  cycle        ExpenseCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  title        String
  emoji        String        @default("💰")
  amount       Decimal       @db.Decimal(12, 2)
  paidBy       String        @map("paid_by")
  payer        User          @relation("ExpensePayer", fields: [paidBy], references: [id], onDelete: Cascade)
  splitType    String        @default("equal") @map("split_type")
  date         DateTime      @default(now())
  settled      Boolean       @default(false)
  settlementId String?       @map("settlement_id")
  settlement   Settlement?   @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  shares       ExpenseShare[]

  @@index([groupId])
  @@index([paidBy])
  @@index([settled])
  @@index([groupId, settled])
  @@map("expenses")
}

model ExpenseShare {
  id        String   @id @default(uuid())
  expenseId String   @map("expense_id")
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)

  @@unique([expenseId, userId])
  @@index([userId])
  @@index([expenseId])
  @@map("expense_shares")
}

model Settlement {
  id          String                   @id @default(uuid())
  groupId     String                   @map("group_id")
  group       Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cycleId     String?                  @map("cycle_id")
  status      String                   @default("pending") // "pending", "completed"
  totalSettled Decimal                 @default(0) @db.Decimal(12, 2) @map("total_settled")
  completedAt DateTime?                @map("completed_at")
  completedBy String?                  @map("completed_by")
  completer   User?                    @relation("SettlementCompleter", fields: [completedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now()) @map("created_at")

  confirmations SettlementConfirmation[]
  transactions  SettlementTransaction[]
  expenses      Expense[]

  @@index([groupId, status])
  @@map("settlements")
}

model SettlementConfirmation {
  id           String     @id @default(uuid())
  settlementId String     @map("settlement_id")
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedAt  DateTime   @default(now()) @map("confirmed_at")

  @@unique([settlementId, userId])
  @@index([userId])
  @@index([settlementId])
  @@map("settlement_confirmations")
}

model SettlementTransaction {
  id           String     @id @default(uuid())
  settlementId String     @map("settlement_id")
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  fromUser     String     @map("from_user")
  toUser       String     @map("to_user")
  amount       Decimal    @db.Decimal(12, 2)

  @@map("settlement_transactions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId  String?  @map("sender_id")
  groupId   String?  @map("group_id")
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

